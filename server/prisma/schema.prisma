generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  REPORTER
  AGENT
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model User {
  id             String    @id @default(cuid())
  name           String
  email          String    @unique
  passwordHash   String
  role           UserRole
  createdAt      DateTime  @default(now())

  reportedTickets Ticket[] @relation("ReportedTickets")
  assignedTickets Ticket[] @relation("AssignedTickets")
  comments        Comment[]

  @@index([role])
}

model Ticket {
  id              String        @id @default(cuid())
  title           String
  description     String
  priority        Priority
  status          TicketStatus  @default(OPEN)

  reporterId      String
  reporter        User          @relation("ReportedTickets", fields: [reporterId], references: [id])

  assigneeId      String?
  assignee        User?         @relation("AssignedTickets", fields: [assigneeId], references: [id])

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  firstResponseAt DateTime?
  resolvedAt      DateTime?

  comments        Comment[]

  @@index([priority])
  @@index([status])
  @@index([reporterId])
  @@index([assigneeId])
  @@index([createdAt])
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id])
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())

  @@index([ticketId])
  @@index([authorId])
}

model Holiday {
  id   String   @id @default(cuid())
  date DateTime @unique
  name String
}
